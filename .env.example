# DIA 環境変数（名前のみ。値はここに書かない）
# 値は Vercel の環境変数、ローカルは .env.local に置く（.env* は .gitignore 済み）

# 画像・動画プロンプト生成（/api/media-prompt）の有効化スイッチ。
# "1" のときだけ有効。未設定・他の値なら 503（E503）を返して Gemini を呼ばない＝フェイルクローズ。
DIA_MEDIA_PROMPT_ENABLED=

# Google Gemini API キー（GOOGLE_API_KEY でも可）。未設定なら 500（E500）で外部呼び出しをしない。
GEMINI_API_KEY=

# 公開サイトの URL。/api/media-prompt の同一オリジン確認に使う。
# 未設定でも canonical（https://dia-wheat.vercel.app）は常に許可される。
NEXT_PUBLIC_SITE_URL=

# 追加で許可するオリジン（カンマ区切り・任意）。既定は空。
# プレビューデプロイは既定で許可しない。試す時だけその URL をここに明示して入れる。
DIA_ALLOWED_ORIGINS=
